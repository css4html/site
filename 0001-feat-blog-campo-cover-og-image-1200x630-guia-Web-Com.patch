+
+## O código
+
+```ts
+export class ImageGallery extends HTMLElement { /* ... */ }
+
+export function register(tag = 'image-gallery') {
+  if (!customElements.get(tag)) {
+    customElements.define(tag, ImageGallery);
+  }
+}
+
+register(); // auto-register no entry padrão
+```
