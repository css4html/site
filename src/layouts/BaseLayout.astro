---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeHtmlLang, type Locale } from '../i18n/config';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  current?: string;
  locale?: Locale;
  /** Imagem de compartilhamento (caminho relativo ou URL absoluta). Padrão: logo-fanpage.png */
  image?: string;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const {
  title,
  description = t('home.desc'),
  current = '',
  image,
} = Astro.props;
const ogImage = image
  ? new URL(image, Astro.site).href
  : 'https://css4html.com.br/logo-fanpage.png';
const fullTitle = title.includes('CSS4HTML') ? title : `${title} · CSS4HTML`;
---
<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    {image && <meta name="twitter:image" content={ogImage} />}
    <meta property="og:url" content={Astro.url.href} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          var KEY = 'css4html-theme';
          var saved = localStorage.getItem(KEY);
          var theme = (saved === 'light' || saved === 'dark')
            ? saved
            : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XVQNHT82RS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XVQNHT82RS');
    </script>
    <!-- Eventos de engajamento (delegação de cliques, um único listener) -->
    <script is:inline>
      (function () {
        function send(name, params) {
          try { if (typeof gtag === 'function') gtag('event', name, params || {}); } catch (e) {}
        }
        document.addEventListener('click', function (ev) {
          var target = ev.target;
          if (!target || !target.closest) return;
          var path = location.pathname;

          // Copiar snippet
          var copyBtn = target.closest('[data-copy]');
          if (copyBtn) { send('snippet_copy', { page_path: path }); return; }

          // Copiar código no playground
          var pgBtn = target.closest('[data-action^="copy-"]');
          if (pgBtn) { send('playground_copy', { page_path: path, lang: pgBtn.getAttribute('data-action').slice(5) }); return; }

          // Elementos marcados com data-track
          var tracked = target.closest('[data-track]');
          if (tracked) {
            send(tracked.getAttribute('data-track'), { label: tracked.getAttribute('data-track-label') || undefined, page_path: path });
            return;
          }

          var link = target.closest('a[href]');
          if (!link) return;
          var url;
          try { url = new URL(link.getAttribute('href'), location.href); } catch (e) { return; }

          // Clique para a consultoria vindo de outra página
          if (url.host === location.host && /\/consultoria\/?$/.test(url.pathname) && !/\/consultoria\/?$/.test(path)) {
            send('consultoria_cta_click', { source_path: path });
            return;
          }

          // Links externos
          if (url.host !== location.host && /^https?:$/.test(url.protocol) && url.host !== 'wa.me') {
            send('outbound_click', { link_domain: url.host, link_url: url.href, page_path: path });
          }
        }, { capture: true });
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'CSS4HTML',
      url: 'https://css4html.com.br/',
      inLanguage: localeHtmlLang[locale],
      publisher: {
        '@type': 'Organization',
        name: 'CSS4HTML',
        url: 'https://css4html.com.br/',
        logo: 'https://css4html.com.br/logo-fanpage.png',
        sameAs: ['https://www.instagram.com/css4html/', 'https://www.facebook.com/CSS4HTML', 'https://github.com/css4html'],
      },
    })} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  </head>
  <body>
    <Header current={current} locale={locale} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
