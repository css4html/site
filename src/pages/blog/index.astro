---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, entrySlug } from '../../i18n/collections';
import { localizePath, useTranslations, type Locale } from '../../i18n/utils';

const locale = 'pt-BR' as Locale;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(locale, p);
const posts = await getBlogPosts(locale);

function formatDate(d: Date) {
  return d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout title={t('blog.title')} description={t('blog.desc')} current="blog" locale={locale}>
  <div class="container page-header">
    <h1>{t('blog.title')}</h1>
    <p>{t('blog.intro')}</p>
  </div>
  <div class="container section" style="padding-top:0">
    <div class="card-grid">
      {posts.map((post) => (
        <article class="card">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <h3 style="margin-top:0.35rem"><a href={lp(`/blog/${entrySlug(post)}/`)}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <ul class="tags">
            {post.data.tags.map((tg) => <li class="tag">{tg}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
