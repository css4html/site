---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout title="Blog" description="Artigos curtos sobre CSS, com links para o hub." current="blog">
  <div class="container page-header">
    <h1>Blog</h1>
    <p>Textos curtos que apontam de volta para exemplos, snippets e a trilha.</p>
  </div>
  <div class="container section" style="padding-top:0">
    <div class="card-grid">
      {posts.map((post) => (
        <article class="card">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <h3 style="margin-top:0.35rem"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <ul class="tags">
            {post.data.tags.map((t) => <li class="tag">{t}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
