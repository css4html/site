---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLessons, entrySlug } from '../../../../i18n/collections';
import { localizePath, useTranslations, type Locale } from '../../../../i18n/utils';

const TRAIL = 'git-na-pratica';
const locale = 'es' as Locale;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(locale, p);

const lessons = (await getLessons(locale))
  .filter((l) => l.data.trail === TRAIL)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title={t('trail.git.pageTitle')}
  description={t('trail.git.pageDesc')}
  current="trilhas"
  locale={locale}
>
  <div class="container page-header">
    <p><a href={lp('/trilhas/')}>{t('trails.back')}</a></p>
    <h1>{t('trail.git.title')}</h1>
    <p>
      {t('trails.progressive')} {lessons.length} {t('trails.progressiveSuffix')}
    </p>
  </div>
  <div class="container">
    <div class="trail-progress">
      {lessons.map((lesson) => (
        <a class="trail-item" href={lp(`/trilhas/git-na-pratica/${entrySlug(lesson)}/`)}>
          <span class="num">{lesson.data.order}</span>
          <span>
            <strong>{lesson.data.title}</strong>
            <br />
            <span style="color:var(--color-muted);font-size:0.92rem">{lesson.data.description}</span>
          </span>
        </a>
      ))}
    </div>
    <p>
      {lessons[0] && (
        <a class="btn btn-primary" href={lp(`/trilhas/git-na-pratica/${entrySlug(lessons[0])}/`)}>
          {t('trails.startLesson1')}
        </a>
      )}
    </p>
  </div>
</BaseLayout>
