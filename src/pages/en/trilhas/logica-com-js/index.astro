---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLessons, entrySlug } from '../../../../i18n/collections';
import { localizePath, useTranslations, type Locale } from '../../../../i18n/utils';

const TRAIL = 'logica-com-js';
const locale = 'en' as Locale;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(locale, p);

const lessons = (await getLessons(locale))
  .filter((l) => l.data.trail === TRAIL)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title={t('trail.logic.pageTitle')}
  description={t('trail.logic.pageDesc')}
  current="trilhas"
  locale={locale}
>
  <div class="container page-header">
    <p><a href={lp('/trilhas/')}>{t('trails.back')}</a></p>
    <h1>{t('trail.logic.title')}</h1>
    <p>
      {lessons.length} {t('trail.logic.availability')}
    </p>
  </div>
  <div class="container">
    <div class="trail-progress">
      {lessons.map((lesson) => (
        <a class="trail-item" href={lp(`/trilhas/logica-com-js/${entrySlug(lesson)}/`)}>
          <span class="num">{lesson.data.order}</span>
          <span>
            <strong>{lesson.data.title}</strong>
            <br />
            <span style="color:var(--color-muted);font-size:0.92rem">{lesson.data.description}</span>
          </span>
        </a>
      ))}
      {([4, 5, 6, 7, 8, 9, 10] as const).map((order) => (
        <div class="trail-item" aria-disabled="true">
          <span class="num">{order}</span>
          <span><strong>{t(`trail.logic.${order}`)}</strong> · <span class="badge track-logic">{t('trail.logic.soon')}</span><br />
            <span style="color:var(--color-muted);font-size:0.92rem">{t(`trail.logic.${order}.desc`)}</span>
          </span>
        </div>
      ))}
    </div>
    <p>
      {lessons[0] && (
        <a class="btn btn-primary" href={lp(`/trilhas/logica-com-js/${entrySlug(lessons[0])}/`)}>
          {t('trails.startLesson1')}
        </a>
      )}
    </p>
  </div>
</BaseLayout>
