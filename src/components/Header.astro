---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { type Locale } from '../i18n/config';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  current?: string;
  locale?: Locale;
}
const { current = '', locale = 'pt-BR' } = Astro.props;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(locale, p);

const links = [
  { href: lp('/'), label: t('nav.home'), id: 'inicio' },
  { href: lp('/trilhas/'), label: t('nav.trails'), id: 'trilhas' },
  { href: lp('/exemplos/'), label: t('nav.examples'), id: 'exemplos' },
  { href: lp('/snippets/'), label: t('nav.snippets'), id: 'snippets' },
  { href: lp('/blog/'), label: t('nav.blog'), id: 'blog' },
];

const themeLight = t('nav.themeLight');
const themeDark = t('nav.themeDark');
const openMenu = t('nav.openMenu');
const closeMenu = t('nav.closeMenu');
---
<a class="sr-only" href="#conteudo">{t('nav.skip')}</a>
<header class="site-header" data-site-header>
  <div class="container inner">
    <a class="logo" href={lp('/')} title="CSS4HTML">
      <img src="/logo-fanpage.png" alt="" width="32" height="32" />
      <span>CSS4HTML</span>
    </a>

    <nav class="nav-desktop" aria-label={t('nav.primary')}>
      <ul class="nav">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Designer slot: language selector (PT / EN / ES) -->
      <LanguageSwitcher locale={locale} />

      <button
        type="button"
        class="icon-btn theme-toggle"
        data-theme-toggle
        data-label-light={themeLight}
        data-label-dark={themeDark}
        aria-label={t('nav.theme')}
        title={t('nav.themeTitle')}
      >
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
        </svg>
      </button>

      <button
        type="button"
        class="icon-btn menu-toggle"
        data-menu-toggle
        data-label-open={openMenu}
        data-label-close={closeMenu}
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label={openMenu}
      >
        <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="nav-drawer" id="nav-drawer" data-nav-drawer hidden>
    <div class="nav-drawer-backdrop" data-menu-close tabindex="-1"></div>
    <div class="nav-drawer-panel" role="dialog" aria-modal="true" aria-label={t('nav.drawer')}>
      <p class="drawer-label">{t('nav.drawerLabel')}</p>
      <nav aria-label={t('nav.mobile')}>
        <ul class="nav">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current === link.id ? 'page' : undefined}
                data-menu-close
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="drawer-label" style="margin-top:1.25rem">{t('nav.trailsLabel')}</p>
      <nav aria-label={t('nav.trailsLabel')}>
        <ul class="nav">
          <li><a href={lp('/trilhas/html-do-zero/')} data-menu-close>{t('nav.trailHtml')}</a></li>
          <li><a href={lp('/trilhas/css-do-zero-ao-layout/')} data-menu-close>{t('nav.trailCss')}</a></li>
          <li><a href={lp('/trilhas/javascript-do-zero/')} data-menu-close>{t('nav.trailJs')}</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var KEY = 'css4html-theme';

    function preferred() {
      try {
        var saved = localStorage.getItem(KEY);
        if (saved === 'light' || saved === 'dark') return saved;
      } catch (e) {}
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }

    function themeLabels(btn) {
      return {
        light: btn.getAttribute('data-label-light') || 'Light theme',
        dark: btn.getAttribute('data-label-dark') || 'Dark theme',
      };
    }

    function apply(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try { localStorage.setItem(KEY, theme); } catch (e) {}
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        var labels = themeLabels(btn);
        btn.setAttribute('aria-label', theme === 'dark' ? labels.light : labels.dark);
      });
    }

    if (!document.documentElement.getAttribute('data-theme')) {
      apply(preferred());
    }

    document.addEventListener('click', function (e) {
      var t = e.target.closest('[data-theme-toggle]');
      if (!t) return;
      var next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      apply(next);
    });

    var header = document.querySelector('[data-site-header]');
    var toggle = document.querySelector('[data-menu-toggle]');
    var drawer = document.querySelector('[data-nav-drawer]');
    if (!toggle || !drawer) return;

    function openMenu() {
      drawer.hidden = false;
      requestAnimationFrame(function () {
        drawer.classList.add('is-open');
      });
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', toggle.getAttribute('data-label-close') || 'Close');
      document.body.classList.add('nav-open');
      var first = drawer.querySelector('.nav a');
      if (first) first.focus();
    }

    function closeMenu() {
      drawer.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', toggle.getAttribute('data-label-open') || 'Open');
      document.body.classList.remove('nav-open');
      setTimeout(function () {
        if (!drawer.classList.contains('is-open')) drawer.hidden = true;
      }, 250);
      toggle.focus();
    }

    toggle.addEventListener('click', function () {
      if (toggle.getAttribute('aria-expanded') === 'true') closeMenu();
      else openMenu();
    });

    drawer.addEventListener('click', function (e) {
      if (e.target.closest('[data-menu-close]')) closeMenu();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });

    function onScroll() {
      if (!header) return;
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
