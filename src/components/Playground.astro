---
interface Props {
  html: string;
  css: string;
  js?: string;
  showJs?: boolean;
  mode?: 'html' | 'react';
  id?: string;
  labels?: {
    actions?: string;
    reset?: string;
    resetTitle?: string;
    copyHtml?: string;
    copyCss?: string;
    copyJs?: string;
    copyJsTitle?: string;
    panels?: string;
    preview?: string;
    editors?: string;
    copy?: string;
    editorHtml?: string;
    editorCss?: string;
    editorJs?: string;
    livePreview?: string;
    iframeTitle?: string;
    previewPanel?: string;
    jsTab?: string;
    jsPane?: string;
    reactShellSummary?: string;
    reactShellHint?: string;
    reactShellViteNote?: string;
    htmlPaneLabel?: string;
  };
}
const { html, css, js = '', id = 'playground', labels = {}, mode = 'html' } = Astro.props;
const isReact = mode === 'react';
const showJs = Astro.props.showJs ?? (Boolean(js) || isReact);
const L = {
  actions: labels.actions ?? 'Ações do playground',
  reset: labels.reset ?? 'Resetar',
  resetTitle: labels.resetTitle ?? 'Restaurar código original',
  copyHtml: labels.copyHtml ?? 'Copiar HTML',
  copyCss: labels.copyCss ?? 'Copiar CSS',
  copyJs: labels.copyJs ?? (isReact ? 'Copiar TSX' : 'Copiar JS'),
  copyJsTitle: labels.copyJsTitle ?? (isReact ? 'Copiar TypeScript/JSX' : 'Copiar JavaScript'),
  panels: labels.panels ?? 'Painéis do playground',
  preview: labels.preview ?? 'Preview',
  editors: labels.editors ?? 'Editores',
  copy: labels.copy ?? 'Copiar',
  editorHtml: labels.editorHtml ?? (isReact ? 'Editor HTML (fora do #root)' : 'Editor HTML'),
  editorCss: labels.editorCss ?? 'Editor CSS',
  editorJs: labels.editorJs ?? (isReact ? 'Editor TSX' : 'Editor JavaScript'),
  livePreview: labels.livePreview ?? 'Pré-visualização ao vivo',
  iframeTitle: labels.iframeTitle ?? 'Pré-visualização do exemplo',
  previewPanel: labels.previewPanel ?? 'Pré-visualização',
  jsTab: labels.jsTab ?? (isReact ? 'TSX' : 'JS'),
  jsPane: labels.jsPane ?? (isReact ? 'TSX / React' : 'JavaScript'),
  reactShellSummary: labels.reactShellSummary ?? 'Esqueleto HTML (como o React monta)',
  reactShellHint: labels.reactShellHint ?? 'O playground injeta #root, import map (esm.sh) e Sucrase. A aba HTML é só markup extra fora do React. Nomeie o componente de topo como App.',
  reactShellViteNote: labels.reactShellViteNote ?? 'Vite local: index.html → src/main.tsx → <App /> em #root. Aqui o playground faz o equivalente com esm.sh + Sucrase.',
  htmlPaneLabel: labels.htmlPaneLabel ?? (isReact ? 'HTML (fora do #root)' : 'HTML'),
};
const htmlB64 = Buffer.from(html, 'utf8').toString('base64');
const cssB64 = Buffer.from(css, 'utf8').toString('base64');
const jsB64 = Buffer.from(js, 'utf8').toString('base64');
---
<div
  class="playground"
  data-playground={id}
  data-mobile-tab={isReact ? 'js' : 'html'}
  data-show-js={showJs ? '1' : '0'}
  data-mode={mode}
>
  <div class="playground-toolbar" role="toolbar" aria-label={L.actions}>
    <button type="button" class="pg-btn" data-action="reset" title={L.resetTitle}>
      {L.reset}
    </button>
    <button type="button" class="pg-btn" data-action="copy-html" title={L.copyHtml}>
      {L.copyHtml}
    </button>
    <button type="button" class="pg-btn" data-action="copy-css" title={L.copyCss}>
      {L.copyCss}
    </button>
    {showJs && (
      <button type="button" class="pg-btn" data-action="copy-js" title={L.copyJsTitle}>
        {L.copyJs}
      </button>
    )}
    <span class="spacer" aria-hidden="true"></span>
    <span class="sr-only" data-status aria-live="polite"></span>
  </div>

  {isReact && (
    <details class="pg-react-shell">
      <summary>{L.reactShellSummary}</summary>
      <p class="pg-react-shell-hint">{L.reactShellHint}</p>
      <pre class="pg-react-shell-code"><code>{`<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>/* CSS tab */</style>
  <script type="importmap">
  {
    "imports": {
      "react": "https://esm.sh/react@19",
      "react-dom/client": "https://esm.sh/react-dom@19/client"
    }
  }
  </script>
</head>
<body>
  <div id="root"></div>
  <!-- HTML tab: optional markup outside React -->
  <script type="module">
    // Sucrase compiles the TSX tab, then:
    // createRoot(document.getElementById('root')).render(<App />)
  </script>
</body>
</html>`}</code></pre>
      <p class="pg-react-shell-hint">{L.reactShellViteNote}</p>
    </details>
  )}

  <div class="playground-tabs" role="tablist" aria-label={L.panels}>
    <button type="button" class="playground-tab" role="tab" id={`${id}-tab-html`} aria-controls={`${id}-panel-editors`} aria-selected={!isReact} data-tab="html">
      HTML
    </button>
    <button type="button" class="playground-tab" role="tab" id={`${id}-tab-css`} aria-controls={`${id}-panel-editors`} aria-selected="false" data-tab="css">
      CSS
    </button>
    {showJs && (
      <button type="button" class="playground-tab" role="tab" id={`${id}-tab-js`} aria-controls={`${id}-panel-editors`} aria-selected={isReact} data-tab="js">
        {L.jsTab}
      </button>
    )}
    <button type="button" class="playground-tab" role="tab" id={`${id}-tab-preview`} aria-controls={`${id}-panel-preview`} aria-selected="false" data-tab="preview">
      {L.preview}
    </button>
  </div>

  <div class="playground-wrap">
    <div class="editor-panel" id={`${id}-panel-editors`} role="tabpanel" aria-label={L.editors}>
      <div class="editor-box" data-pane="html">
        <div class="label">
          <span id={`${id}-label-html`}>{L.htmlPaneLabel}</span>
          <div class="label-actions">
            <button type="button" class="pg-btn" data-action="copy-html" aria-describedby={`${id}-label-html`}>{L.copy}</button>
          </div>
        </div>
        <div
          class="cm-host"
          data-editor="html"
          data-initial={htmlB64}
          role="textbox"
          aria-label={L.editorHtml}
          aria-multiline="true"
        ></div>
      </div>
      <div class="editor-box" data-pane="css">
        <div class="label">
          <span id={`${id}-label-css`}>CSS</span>
          <div class="label-actions">
            <button type="button" class="pg-btn" data-action="copy-css" aria-describedby={`${id}-label-css`}>{L.copy}</button>
          </div>
        </div>
        <div
          class="cm-host"
          data-editor="css"
          data-initial={cssB64}
          role="textbox"
          aria-label={L.editorCss}
          aria-multiline="true"
        ></div>
      </div>
      {showJs && (
        <div class="editor-box" data-pane="js">
          <div class="label">
            <span id={`${id}-label-js`}>{L.jsPane}</span>
            <div class="label-actions">
              <button type="button" class="pg-btn" data-action="copy-js" aria-describedby={`${id}-label-js`}>{L.copy}</button>
            </div>
          </div>
          <div
            class="cm-host"
            data-editor="js"
            data-initial={jsB64}
            role="textbox"
            aria-label={L.editorJs}
            aria-multiline="true"
          ></div>
        </div>
      )}
    </div>
    <div class="preview-panel" id={`${id}-panel-preview`} role="tabpanel" aria-label={L.previewPanel}>
      <div class="label"><span>{L.livePreview}</span></div>
      <iframe title={L.iframeTitle} data-preview sandbox="allow-scripts allow-same-origin allow-forms"></iframe>
    </div>
  </div>
</div>

<script>
  import { EditorView, basicSetup } from 'codemirror';
  import { EditorState } from '@codemirror/state';
  import { html as htmlLang } from '@codemirror/lang-html';
  import { css as cssLang } from '@codemirror/lang-css';
  import { javascript as jsLang } from '@codemirror/lang-javascript';
  import { oneDark } from '@codemirror/theme-one-dark';

  function decodeB64(value: string) {
    try {
      return new TextDecoder().decode(Uint8Array.from(atob(value), (c) => c.charCodeAt(0)));
    } catch {
      return '';
    }
  }

  function escapeForScript(js: string) {
    return js.replace(/<\/script/gi, '<\\/script');
  }

  function buildSrcdoc(html: string, css: string, js: string) {
    const scriptBlock = js.trim()
      ? `<script>${escapeForScript(js)}<\/script>`
      : '';
    return `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
html,body{margin:0;padding:16px;font-family:system-ui,sans-serif}
${css}
</style></head><body>${html}${scriptBlock}</body></html>`;
  }

  // Runtime that runs *inside* the React preview iframe.
  // Kept in String.raw so regex/string escapes (\b, \s, \n, \/) reach the iframe
  // verbatim. Rules for this block: no backticks, no "${", and never a literal
  // closing script tag (the outer <script> in the srcdoc would end early).
  const REACT_RUNTIME = String.raw`
function showError(err) {
  const pre = document.createElement('pre');
  pre.style.cssText = 'color:#b91c1c;white-space:pre-wrap;font:13px/1.45 ui-monospace,monospace;padding:8px';
  pre.textContent = (err && (err.stack || err.message)) ? String(err.stack || err.message) : String(err);
  document.body.prepend(pre);
}

try {
  const { transform } = await import('https://esm.sh/sucrase@3.35.0');
  const source = JSON.parse(document.getElementById('__pg_tsx').textContent || '""');
  let compiled = transform(source, {
    transforms: ['typescript', 'jsx'],
    jsxRuntime: 'classic',
  }).code;

  compiled += [
    '',
    ';',
    "const __mount = document.getElementById('root');",
    "if (typeof App !== 'undefined' && __mount) {",
    '  createRoot(__mount).render(React.createElement(App));',
    '}',
    '',
  ].join('\n');

  // createRoot is used by the mount code above: import it unless the user already did
  if (!/\bimport\s*\{[^}]*\bcreateRoot\b[^}]*\}\s*from\s*['"]react-dom\/client['"]/.test(compiled)) {
    compiled = 'import { createRoot } from "react-dom/client";\n' + compiled;
  }
  // Ensure React binding for classic JSX / React.createElement
  if (!/\bimport\s+React\b/.test(compiled) && !/\bimport\s+\*\s+as\s+React\b/.test(compiled)) {
    compiled = 'import React from "react";\n' + compiled;
  }

  const blob = new Blob([compiled], { type: 'text/javascript' });
  const url = URL.createObjectURL(blob);
  await import(url);
  URL.revokeObjectURL(url);
} catch (e) {
  showError(e);
}
`;

  const REACT_IMPORT_MAP = JSON.stringify({
    imports: {
      react: 'https://esm.sh/react@19',
      'react/': 'https://esm.sh/react@19/',
      'react/jsx-runtime': 'https://esm.sh/react@19/jsx-runtime',
      'react-dom': 'https://esm.sh/react-dom@19',
      'react-dom/': 'https://esm.sh/react-dom@19/',
      'react-dom/client': 'https://esm.sh/react-dom@19/client',
      '@tanstack/react-query': 'https://esm.sh/@tanstack/react-query@5?deps=react@19,react-dom@19',
      zustand: 'https://esm.sh/zustand@5',
    },
  }, null, 2);

  /** JSON that is safe inside a <script> element: every "<" becomes the JSON escape u003c. */
  function jsonForScript(value: unknown) {
    const lt = String.fromCharCode(92) + 'u003c';
    return JSON.stringify(value).replace(/</g, lt);
  }

  function buildReactSrcdoc(html: string, css: string, tsx: string) {
    const close = '</' + 'script>';
    return '<!DOCTYPE html><html><head><meta charset="utf-8"><style>\n'
      + 'html,body{margin:0;padding:16px;font-family:system-ui,sans-serif}\n'
      + css + '\n'
      + '</style>\n'
      + '<script type="importmap">\n' + REACT_IMPORT_MAP + '\n' + close + '\n'
      + '</head><body>\n'
      + '<div id="root"></div>\n'
      + html + '\n'
      + '<script type="application/json" id="__pg_tsx">' + jsonForScript(tsx) + close + '\n'
      + '<script type="module">' + REACT_RUNTIME + close + '\n'
      + '</body></html>';
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function setStatus(root: Element, message: string) {
    const el = root.querySelector('[data-status]');
    if (el) el.textContent = message;
  }

  function mountPlayground(root: Element) {
    if ((root as HTMLElement).dataset.ready === '1') return;
    (root as HTMLElement).dataset.ready = '1';

    const showJs = (root as HTMLElement).dataset.showJs === '1';
    const mode = (root as HTMLElement).dataset.mode || 'html';
    const isReact = mode === 'react';
    const htmlHost = root.querySelector('[data-editor="html"]') as HTMLElement | null;
    const cssHost = root.querySelector('[data-editor="css"]') as HTMLElement | null;
    const jsHost = root.querySelector('[data-editor="js"]') as HTMLElement | null;
    const iframe = root.querySelector('[data-preview]') as HTMLIFrameElement | null;
    if (!htmlHost || !cssHost || !iframe) return;
    if (showJs && !jsHost) return;

    const initialHtml = decodeB64(htmlHost.dataset.initial || '');
    const initialCss = decodeB64(cssHost.dataset.initial || '');
    const initialJs = jsHost ? decodeB64(jsHost.dataset.initial || '') : '';
    let htmlCode = initialHtml;
    let cssCode = initialCss;
    let jsCode = initialJs;
    let timer: number | undefined;

    const update = () => {
      if (isReact) {
        iframe.srcdoc = buildReactSrcdoc(htmlCode, cssCode, showJs ? jsCode : '');
      } else {
        iframe.srcdoc = buildSrcdoc(htmlCode, cssCode, showJs ? jsCode : '');
      }
    };

    const scheduleUpdate = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(update, isReact ? 350 : 0);
    };

    const sharedTheme = [
      basicSetup,
      oneDark,
      EditorView.theme({
        '&': { fontSize: '13px' },
        '.cm-scroller': { overflow: 'auto', maxHeight: '280px' },
      }),
      EditorView.updateListener.of((v) => {
        if (!v.docChanged) return;
        const parent = v.view.dom.closest('[data-editor]');
        const kind = parent?.getAttribute('data-editor');
        if (kind === 'html') htmlCode = v.state.doc.toString();
        if (kind === 'css') cssCode = v.state.doc.toString();
        if (kind === 'js') jsCode = v.state.doc.toString();
        scheduleUpdate();
      }),
    ];

    const htmlView = new EditorView({
      parent: htmlHost,
      state: EditorState.create({
        doc: htmlCode,
        extensions: [...sharedTheme, htmlLang()],
      }),
    });

    const cssView = new EditorView({
      parent: cssHost,
      state: EditorState.create({
        doc: cssCode,
        extensions: [...sharedTheme, cssLang()],
      }),
    });

    let jsView: EditorView | null = null;
    if (showJs && jsHost) {
      jsView = new EditorView({
        parent: jsHost,
        state: EditorState.create({
          doc: jsCode,
          extensions: [
            ...sharedTheme,
            jsLang({ jsx: true, typescript: isReact }),
          ],
        }),
      });
    }

    function setDoc(view: EditorView, value: string) {
      view.dispatch({
        changes: { from: 0, to: view.state.doc.length, insert: value },
      });
    }

    root.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.getAttribute('data-action');
        if (action === 'reset') {
          setDoc(htmlView, initialHtml);
          setDoc(cssView, initialCss);
          if (jsView) setDoc(jsView, initialJs);
          htmlCode = initialHtml;
          cssCode = initialCss;
          jsCode = initialJs;
          update();
          setStatus(root, 'Código restaurado.');
          (btn as HTMLButtonElement).textContent = 'Resetado!';
          setTimeout(() => { (btn as HTMLButtonElement).textContent = 'Resetar'; }, 1200);
          return;
        }
        if (action === 'copy-html') {
          const ok = await copyText(htmlCode);
          setStatus(root, ok ? 'HTML copiado.' : 'Não foi possível copiar.');
          const label = (btn as HTMLButtonElement).textContent || 'Copiar';
          (btn as HTMLButtonElement).textContent = ok ? 'Copiado!' : 'Erro';
          setTimeout(() => { (btn as HTMLButtonElement).textContent = label.includes('HTML') ? 'Copiar HTML' : 'Copiar'; }, 1200);
          return;
        }
        if (action === 'copy-css') {
          const ok = await copyText(cssCode);
          setStatus(root, ok ? 'CSS copiado.' : 'Não foi possível copiar.');
          const label = (btn as HTMLButtonElement).textContent || 'Copiar';
          (btn as HTMLButtonElement).textContent = ok ? 'Copiado!' : 'Erro';
          setTimeout(() => { (btn as HTMLButtonElement).textContent = label.includes('CSS') ? 'Copiar CSS' : 'Copiar'; }, 1200);
          return;
        }
        if (action === 'copy-js') {
          const ok = await copyText(jsCode);
          setStatus(root, ok ? (isReact ? 'TSX copiado.' : 'JavaScript copiado.') : 'Não foi possível copiar.');
          const label = (btn as HTMLButtonElement).textContent || 'Copiar';
          (btn as HTMLButtonElement).textContent = ok ? 'Copiado!' : 'Erro';
          setTimeout(() => {
            const restore = label.includes('TSX') ? 'Copiar TSX' : label.includes('JS') ? 'Copiar JS' : 'Copiar';
            (btn as HTMLButtonElement).textContent = restore;
          }, 1200);
        }
      });
    });

    root.querySelectorAll('[data-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        const name = tab.getAttribute('data-tab') || 'html';
        (root as HTMLElement).dataset.mobileTab = name;
        root.querySelectorAll('[data-tab]').forEach((t) => {
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
      });
    });

    update();
  }

  function init() {
    document.querySelectorAll('[data-playground]').forEach(mountPlayground);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
