---
import '../styles/consultoria.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Locale } from '../i18n/config';
import { localizePath, useTranslations } from '../i18n/utils';
import ConsultoriaHero from './ConsultoriaHero.astro';
import { consultoriaClients } from '../data/consultoria-clients';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(locale, p);

const services = [
  { icon: 'code-xml.svg', title: t('consultoria.svc1Title'), desc: t('consultoria.svc1Desc') },
  { icon: 'smartphone.svg', title: t('consultoria.svc2Title'), desc: t('consultoria.svc2Desc') },
  { icon: 'wrench.svg', title: t('consultoria.svc3Title'), desc: t('consultoria.svc3Desc') },
  { icon: 'component.svg', title: t('consultoria.svc4Title'), desc: t('consultoria.svc4Desc') },
  { icon: 'gauge.svg', title: t('consultoria.svc5Title'), desc: t('consultoria.svc5Desc') },
  { icon: 'messages-square.svg', title: t('consultoria.svc6Title'), desc: t('consultoria.svc6Desc') },
];

const steps = [
  { n: '1.', title: t('consultoria.step1Title'), desc: t('consultoria.step1Desc') },
  { n: '2.', title: t('consultoria.step2Title'), desc: t('consultoria.step2Desc') },
  { n: '3.', title: t('consultoria.step3Title'), desc: t('consultoria.step3Desc') },
  { n: '4.', title: t('consultoria.step4Title'), desc: t('consultoria.step4Desc') },
];

const checks = [
  t('consultoria.check1'),
  t('consultoria.check2'),
  t('consultoria.check3'),
  t('consultoria.check4'),
];

const iaItems = [
  { title: t('consultoria.iaItem1Title'), desc: t('consultoria.iaItem1Desc') },
  { title: t('consultoria.iaItem2Title'), desc: t('consultoria.iaItem2Desc') },
  { title: t('consultoria.iaItem3Title'), desc: t('consultoria.iaItem3Desc') },
  { title: t('consultoria.iaItem4Title'), desc: t('consultoria.iaItem4Desc') },
];

const stack = ['HTML', 'CSS', 'JavaScript', 'TypeScript', 'Vite', 'React', 'Vue', 'Web Components', 'Firebase', 'C#', 'Ruby on Rails', 'Node.js', 'PHP', 'Elixir'];

const icon = (name: string) => `/consultoria/icons/${name}`;
const waBaseMsg = t('consultoria.waMessage');
---
<BaseLayout
  title={t('consultoria.title')}
  description={t('consultoria.desc')}
  current="consultoria"
  locale={locale}
  image="/consultoria/og.png"
>
  <div class="consultoria" data-consultoria data-wa-msg={waBaseMsg}>
    <ConsultoriaHero locale={locale} context="consultoria" />

    <section class="c-section" id="servicos">
      <div class="c-wrap">
        <header class="c-section-head">
          <p class="c-kicker">{t('consultoria.servicesKicker')}</p>
          <h2>{t('consultoria.servicesTitle')}</h2>
        </header>
        <div class="c-services">
          {services.map((s) => (
            <article class="c-service">
              <img src={icon(s.icon)} alt="" width="28" height="28" />
              <div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c-section" id="setup-ia">
      <div class="c-wrap">
        <header class="c-section-head">
          <p class="c-kicker">{t('consultoria.iaKicker')}</p>
          <h2>{t('consultoria.iaTitle')}</h2>
          <p class="c-section-lead">{t('consultoria.iaLead')}</p>
        </header>
        <div class="c-services">
          {iaItems.map((item) => (
            <article class="c-service">
              <div>
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="c-ia-actions">
          <a
            class="c-btn c-btn-wa"
            href="https://wa.me/5512992159872"
            data-wa-cta="setup-ia"
            data-wa-msg={t('consultoria.iaWaMessage')}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={icon('whatsapp.svg')} alt="" width="22" height="22" />
            {t('consultoria.iaCta')}
          </a>
        </div>
      </div>
    </section>

    <section class="c-section" id="como-trabalhamos">
      <div class="c-wrap">
        <header class="c-section-head">
          <p class="c-kicker">{t('consultoria.howKicker')}</p>
          <h2>{t('consultoria.howTitle')}</h2>
        </header>
        <div class="c-steps">
          {steps.map((s) => (
            <article class="c-step">
              <p class="c-step-num">{s.n}</p>
              <div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c-section" id="por-que">
      <div class="c-wrap c-why">
        <div class="c-why-intro">
          <p class="c-kicker">{t('consultoria.whyKicker')}</p>
          <h2 style="margin:0.65rem 0 0;font-size:clamp(1.6rem,3vw,2.35rem);line-height:1.15;color:var(--c-ink)">
            {t('consultoria.whyTitle')}
          </h2>
          <p>{t('consultoria.whyLead')}</p>
        </div>
        <ul class="c-checks">
          {checks.map((c) => (
            <li>
              <img src={icon('check.svg')} alt="" width="22" height="22" />
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="c-section" id="clientes">
      <div class="c-wrap">
        <header class="c-section-head">
          <p class="c-kicker">{t('consultoria.clientsKicker')}</p>
          <h2>{t('consultoria.clientsTitle')}</h2>
          <p class="c-section-lead">{t('consultoria.clientsLead')}</p>
        </header>
        <div class="c-clients">
          {consultoriaClients.map((client) => (
            <article class="c-client">
              <div class="c-client-head">
                <img src={client.icon} alt="" width="32" height="32" />
                <h3>{client.name}</h3>
              </div>
              <p>{t(client.descKey)}</p>
              <a href={client.href} target="_blank" rel="noopener">
                {t('consultoria.clientVisit')}
                <span aria-hidden="true"> ↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c-stack c-wrap" aria-label={t('consultoria.stackLabel')}>
      <p class="c-stack-label">{t('consultoria.stackLabel')}</p>
      <ul class="c-pills">
        {stack.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </section>

    <section class="c-cta c-wrap">
      <div class="c-cta-card">
        <h2>{t('consultoria.finalTitle')}</h2>
        <p>{t('consultoria.finalLead')}</p>
        <a
          class="c-btn c-btn-wa"
          href="https://wa.me/5512992159872"
          data-wa-cta
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={icon('whatsapp.svg')} alt="" width="22" height="22" />
          {t('consultoria.ctaWa')}
        </a>
      </div>
    </section>

    <a
      class="c-sticky-wa"
      href="https://wa.me/5512992159872"
      data-wa-cta
      target="_blank"
      rel="noopener noreferrer"
    >
      <img src={icon('whatsapp.svg')} alt="" width="22" height="22" />
      {t('consultoria.ctaWa')}
    </a>
  </div>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-consultoria]');
      if (!root) return;
      var baseMsg = root.getAttribute('data-wa-msg') || '';
      var params = new URLSearchParams(window.location.search);
      var utm = params.get('utm_source');
      function buildHref(customMsg) {
        var msg = customMsg || baseMsg;
        if (utm) msg = msg + ' (via ' + utm + ')';
        return 'https://wa.me/5512992159872?text=' + encodeURIComponent(msg);
      }
      document.querySelectorAll('[data-wa-cta]').forEach(function (a) {
        var custom = a.getAttribute('data-wa-msg') || '';
        a.setAttribute('href', buildHref(custom));
        a.addEventListener('click', function () {
          try {
            if (typeof gtag === 'function') {
              gtag('event', 'consultoria_whatsapp_click', {
                event_category: 'consultoria',
                event_label: a.getAttribute('data-wa-cta') || utm || 'direct',
                utm_source: utm || undefined,
              });
            }
          } catch (e) {}
        });
      });
    })();
  </script>
</BaseLayout>
